# Docker settings for FlexiTrack (read by docker-compose.yml).
# Copy this file to `.env` in the same folder and fill it in.
# App secrets (JWT, email, OTP...) stay in backend/.env as before.

# --- Ports opened on the server (change if they clash with another app) ---
# HR web console
WEB_PORT=8080
# Backend API (the mobile app connects to this one directly)
BACKEND_PORT=5000

# --- FlexiTrack's own Postgres (stored on this server, in a Docker volume) ---
POSTGRES_DB=flexitrack
POSTGRES_USER=flexitrack
# Use a long random password made of letters and numbers only. Symbols like
# @ : / # ? would break the database connection URL.
POSTGRES_PASSWORD=

# --- Browser addresses allowed to use the API ---
# Every address people type to open the HR console, comma-separated,
# exactly as shown in the browser bar (protocol + host + port).
# Example: http://localhost:8080,http://10.20.30.40:8080,https://flexitrack.company.com
CORS_ALLOWED_ORIGINS=http://localhost:8080
