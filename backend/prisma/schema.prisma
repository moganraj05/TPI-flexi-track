generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  worker
  incharge
  supervisor
  admin
  superadmin
  hr
}

enum PollStatus {
  open
  closed
}

enum ResponseAnswer {
  yes
  no
}

enum FollowUpStatus {
  pending
  contacted
  confirmed_coming
  confirmed_not_coming
}

// Self-registered HR logins start as `pending` (and inactive) until an
// admin/superadmin approves them. Every account created any other way —
// admin-created logins, workers, incharges, seeds — is `approved` from the
// start, which is also what every pre-existing row gets.
enum ApprovalStatus {
  pending
  approved
}

// Worker-app "Forgot password?" requests (see password-reset.service.js).
enum ResetRequestStatus {
  pending   // waiting for the incharge / supervisor
  approved  // a temporary password was issued
  rejected  // the handler decided it wasn't genuine
  expired   // nobody acted in time
  cancelled // the person signed in normally before anyone acted
}

// Who a pending reset request is currently with. It moves up when nobody
// acts in time (password-reset.service.js escalation job).
enum ResetRequestLevel {
  incharge   // the worker's own incharge
  supervisor // the plant's supervisors
  staff      // HR / admin in the staff console
}

enum OtpPurpose {
  register
  reset_password
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]
  polls Poll[]

  @@map("departments")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @unique @map("employee_id")
  name         String
  email        String?  @unique
  phone        String?
  password     String
  role         Role     @default(worker)
  departmentId String?  @map("department_id") @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  inchargeId   String?  @map("incharge_id") @db.Uuid
  incharge     User?    @relation("WorkerIncharge", fields: [inchargeId], references: [id], onDelete: SetNull)
  reports      User[]   @relation("WorkerIncharge")
  shiftStart   String?  @map("shift_start")
  shiftEnd     String?  @map("shift_end")
  shiftName    String?  @map("shift_name")
  equipment    String?
  process      String?
  pushToken    String?  @map("push_token")
  isActive     Boolean  @default(true) @map("is_active")
  tokenVersion Int      @default(0) @map("token_version")
  approvalStatus ApprovalStatus @default(approved) @map("approval_status")
  emailVerifiedAt DateTime? @map("email_verified_at")
  approvedAt   DateTime? @map("approved_at")
  approvedById String?  @map("approved_by") @db.Uuid
  // Staff/admin logins created by an admin start with no usable password:
  // the person sets their own from the invitation email (staff-invite.service).
  mustSetPassword Boolean  @default(false) @map("must_set_password")
  invitedAt       DateTime? @map("invited_at")
  // Worker app (workers / incharges / supervisors): set when the account was
  // given a temporary password (new account, reset) or an admin required a
  // change. Until the person sets their own, the server allows only
  // "change my password" (middleware/auth.js).
  mustChangePassword    Boolean   @default(false) @map("must_change_password")
  // When the current temporary password stops working; null = the current
  // password doesn't expire (e.g. "required a change" on an existing one).
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at")
  // Last successful worker-app sign-in (shown on password reset requests).
  lastLoginAt           DateTime? @map("last_login_at")
  // When the person last chose their own worker-app password.
  passwordChangedAt     DateTime? @map("password_changed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  pollsCreated      Poll[]     @relation("PollCreatedBy")
  responses         Response[]
  followUpsAsWorker FollowUp[] @relation("FollowUpWorker")
  followUpsUpdated  FollowUp[] @relation("FollowUpUpdatedBy")
  webPushSubscriptions WebPushSubscription[]
  passwordResetRequests PasswordResetRequest[]

  @@map("users")
}

// Append-only record of every action that changes data or exposes it (who,
// what, which record, before -> after, when, from where). Written by
// src/services/audit.service.js; read by admins in the HR console.
//
// Deliberately no foreign keys: an entry must outlive the account or record
// it mentions, so the actor and target are stored as snapshots (name, role,
// employee ID / email at the time) alongside their IDs. A database trigger
// (see this table's migration) rejects UPDATE always, and DELETE unless the
// retention switch `flexitrack.allow_audit_delete` is set for the session —
// history can't be quietly edited, even with direct database access.
model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  // Who: null actorId = not signed in (failed sign-in, self-registration,
  // forgot password) or the system itself.
  actorId         String?  @map("actor_id") @db.Uuid
  actorName       String?  @map("actor_name")
  actorRole       String?  @map("actor_role")
  actorIdentifier String?  @map("actor_identifier")
  // What: dotted action code ("member.updated"); category = its first part.
  action          String
  category        String
  // Which record.
  entityType      String?  @map("entity_type")
  entityId        String?  @map("entity_id")
  entityLabel     String?  @map("entity_label")
  // Plain-language sentence shown in the log.
  summary         String
  // [{ field, label, from, to }] — secrets appear only as "changed".
  changes         Json?
  metadata        Json?
  // From where.
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  requestId       String?  @map("request_id")

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// One row per browser/installed-web-app that opted in to notifications
// (Web Push). Unlike the Expo `pushToken` column above — one native app per
// user — a person can be subscribed from several browsers at once, so this
// is its own table. `endpoint` is the push service URL the browser handed
// out; it identifies the subscription and is unique across all users (the
// same browser re-subscribing under a different login moves the row).
model WebPushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?   @map("user_agent")
  lastSuccessAt DateTime? @map("last_success_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("web_push_subscriptions")
}

model Poll {
  id                    String     @id @default(uuid()) @db.Uuid
  title                 String
  description           String?
  departmentId          String     @map("department_id") @db.Uuid
  department            Department @relation(fields: [departmentId], references: [id])
  date                  DateTime   @db.Date
  shift                 String     @default("general")
  shiftStart            String?    @map("shift_start")
  shiftEnd              String?    @map("shift_end")
  status                PollStatus @default(open)
  opensAt               DateTime   @map("opens_at")
  closesAt              DateTime   @map("closes_at")
  createdById           String?    @map("created_by") @db.Uuid
  createdBy             User?      @relation("PollCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  autoCreated           Boolean    @default(true) @map("auto_created")
  sendReminder          Boolean    @default(true) @map("send_reminder")
  reminderMinutesBefore Int        @default(30) @map("reminder_minutes_before")
  reminderSentAt        DateTime?  @map("reminder_sent_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  responses Response[]
  followUps FollowUp[]

  @@unique([departmentId, shiftStart, shiftEnd, date], map: "uniq_shift_poll")
  // Covers the single hottest query pattern in the app: "open polls whose
  // window contains now" (every worker's live-poll check, every HR
  // dashboard/live-board load, every realtime-triggered refetch) and the
  // auto-close sweep (status='open', closesAt<=now) that runs on nearly
  // every request. Both lead with status, which is why one index serves
  // both instead of needing two.
  @@index([status, closesAt])
  @@map("polls")
}

model Response {
  id         String         @id @default(uuid()) @db.Uuid
  pollId     String         @map("poll_id") @db.Uuid
  poll       Poll           @relation(fields: [pollId], references: [id])
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id])
  answer     ResponseAnswer
  answeredAt DateTime       @default(now()) @map("answered_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@unique([pollId, userId])
  // Response is the fastest-growing table in the schema (one row per
  // worker per poll, indefinitely) — this covers "my response history"
  // (every worker's History tab: userId filter, answeredAt sort, take 90),
  // which the (pollId, userId) unique index above doesn't serve since
  // userId isn't its leading column.
  @@index([userId, answeredAt])
  @@map("responses")
}

model FollowUp {
  id          String         @id @default(uuid()) @db.Uuid
  workerId    String         @map("worker_id") @db.Uuid
  worker      User           @relation("FollowUpWorker", fields: [workerId], references: [id])
  pollId      String         @map("poll_id") @db.Uuid
  poll        Poll           @relation(fields: [pollId], references: [id])
  status      FollowUpStatus @default(pending)
  note        String?
  updatedById String?        @map("updated_by") @db.Uuid
  updatedBy   User?          @relation("FollowUpUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([workerId, pollId])
  // getFollowUps filters by `pollId IN (...)` across the open polls — not
  // served by the (workerId, pollId) unique index above since pollId isn't
  // its leading column.
  @@index([pollId])
  @@map("followups")
}

// One row per emailed one-time code (HR self-registration and forgot-password).
// Only an HMAC of the code is stored, never the code itself. A row is live
// while consumedAt is null and expiresAt is in the future; sending a new code
// for the same email+purpose consumes any older live one, so only the latest
// code ever works. `payload` carries the registration details (name, employee
// ID, plant, phone) between the send step and the final set-password step.
model EmailOtp {
  id         String     @id @default(uuid()) @db.Uuid
  email      String
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  payload    Json?
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at")
  verifiedAt DateTime?  @map("verified_at")
  consumedAt DateTime?  @map("consumed_at")
  requestIp  String?    @map("request_ip")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_otps")
}

// A worker/incharge who forgot their password asks for help from the app's
// login page. It goes to their incharge (or the plant's supervisors), who
// confirms it's really them and issues a temporary password. One open request
// per person; asking again refreshes it. Rows are kept as history.
// Sessions ended by "Log out" on one device. Logging out revokes only that
// sign-in (its token's session id); the person stays signed in everywhere
// else. Rows can be deleted once the token would have expired anyway.
// (Signing out everywhere — password change/reset — bumps users.token_version.)
model RevokedSession {
  key       String   @id
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("revoked_sessions")
}

model PasswordResetRequest {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Plant at the time, and who it was sent to (null = the plant's
  // supervisors). Plain ids, not relations: history outlives the people.
  departmentId    String?            @map("department_id") @db.Uuid
  routedToId      String?            @map("routed_to_id") @db.Uuid
  status          ResetRequestStatus @default(pending)
  requestCount    Int                @default(1) @map("request_count")
  createdAt       DateTime           @default(now()) @map("created_at")
  lastRequestedAt DateTime           @default(now()) @map("last_requested_at")
  expiresAt       DateTime           @map("expires_at")
  notifiedAt      DateTime?          @map("notified_at")
  requestIp       String?            @map("request_ip")
  userAgent       String?            @map("user_agent")
  handledById     String?            @map("handled_by_id") @db.Uuid
  handledByName   String?            @map("handled_by_name")
  handledAt       DateTime?          @map("handled_at")
  rejectReason    String?            @map("reject_reason")
  // When the person set their own password after the reset.
  completedAt     DateTime?          @map("completed_at")
  // Who has it now, and when it last moved up (null = never escalated).
  level           ResetRequestLevel  @default(incharge)
  escalatedAt     DateTime?          @map("escalated_at")

  @@index([userId, status])
  @@index([status, level])
  @@index([departmentId, status])
  @@index([routedToId, status])
  @@map("password_reset_requests")
}
