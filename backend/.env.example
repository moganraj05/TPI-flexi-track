PORT=5000
# development here is a local-dev default only. Production deployments MUST
# set this to `production` explicitly — it's what makes CORS fail closed
# (config/cors.js) and stops 500 errors from leaking raw driver/Prisma
# messages to clients (middleware/errorHandler.js). Forgetting to change it
# doesn't stop the app from running, so it's easy to miss unless checked.
NODE_ENV=development

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=365d

POLL_OPEN_AFTER_SHIFT_MINUTES=30
POLL_CLOSE_BEFORE_NEXT_SHIFT_HOURS=2
# If the server was down for a poll window, create the poll late (before the shift starts) and keep it open this many minutes
POLL_LATE_ANSWER_MINUTES=30
POLL_AUTOMATION_INTERVAL_MS=60000
REMINDER_CHECK_INTERVAL_MS=300000

# Postgres via Prisma. If pooling through PgBouncer/Supabase's transaction
# pooler (pgbouncer=true), keep connection_limit modest — PgBouncer already
# multiplexes many app-level connections onto a small number of real ones;
# 300-400 workers making short, bursty requests around shift changes are
# comfortably served by connection_limit=10-20 here, not one-per-worker.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=15"
# Session-mode/direct connection, used for migrations (`prisma migrate`).
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Security hardening ---

# Comma-separated list of browser origins allowed to call this API (the
# webfrontend / hrfrontend URLs). No Origin header at all (mobile app,
# curl, server-to-server) is never subject to this — CORS only gates
# browser fetch()/XHR calls. Leaving this unset in production means no
# browser origin is allowed (fail closed); in development it defaults to
# http://localhost:5173 and http://localhost:5174.
# Example: CORS_ALLOWED_ORIGINS=https://hr.flexitrack.example.com
CORS_ALLOWED_ORIGINS=

# Set to the number of reverse-proxy hops in front of this process (usually
# 1) ONLY when actually deployed behind one (nginx, a load balancer, a PaaS
# router). Leave unset/0 for direct LAN access — trusting X-Forwarded-For
# without an actual proxy in front lets a client spoof its IP and dodge
# per-IP rate limiting.
TRUST_PROXY=0

# Max JSON request body size accepted by express.json().
BODY_LIMIT=100kb

# Rate limits. *_WINDOW_MS is the rolling window, *_MAX is the request cap
# per source IP within that window.
#   LOGIN      -> POST /api/auth/login, POST /api/hr/login
#   SENSITIVE  -> account/credential writes (team & HR-admin CRUD, password
#                 change, plant CRUD) — low-volume, HR/incharge-only actions
#   API        -> blanket backstop across all of /api/*, sized for the full
#                 300-400 worker load polling around shift changes
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SENSITIVE_WINDOW_MS=900000
RATE_LIMIT_SENSITIVE_MAX=60
# Worker-app "Forgot password?" requests per IP (a whole factory may share one IP)
RATE_LIMIT_FORGOT_WINDOW_MS=900000
RATE_LIMIT_FORGOT_MAX=30
# Unanswered worker password reset requests move up (incharge -> supervisors -> HR) after this many hours
RESET_REQUEST_ESCALATE_HOURS=12
RESET_REQUEST_CHECK_INTERVAL_MS=300000
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=600

# --- HR self-registration & forgot password (email OTP) ---

# Which service sends the emails: "gmail" or "resend".
# Without the chosen provider's credentials: in development the email body
# (including the code) is written to the server log instead; in production
# every OTP request fails with 503 until it is configured.
EMAIL_PROVIDER=gmail

# gmail: sends from this Gmail account. GMAIL_APP_PASSWORD is a Google
# "App Password" (Google Account -> Security -> 2-Step Verification ->
# App passwords), NOT the normal Gmail password. Limit about 500 emails/day.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# resend: https://resend.com -> API Keys ("Sending access"). EMAIL_FROM_ADDRESS
# must be on a domain verified in Resend (Domains), e.g.
# noreply@mail.tii.murugappa.com. Resend's test sender onboarding@resend.dev
# only delivers to the email address of your own Resend account.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Display name shown as the sender, for either provider.
EMAIL_FROM_NAME=FlexiTrack

# The website address people open FlexiTrack at (no trailing slash), used for
# links in emails — e.g. the "Set my password" link in a staff invitation.
# Defaults to the first CORS_ALLOWED_ORIGINS entry when unset.
# Example: PUBLIC_APP_URL=https://flexitrack.vercel.app
PUBLIC_APP_URL=

# Only these email domains may self-register (comma-separated).
HR_ALLOWED_EMAIL_DOMAINS=tii.murugappa.com

# --- Web Push (notifications in the worker/incharge web app) ---

# A VAPID key pair identifies this server to the browsers' push services.
# Generate ONE pair per deployment with `npm run push:vapid-keys` and paste
# both values here. Keep them stable: changing them drops every existing
# browser subscription until each person opens the app again. Leave empty to
# run without browser notifications (the Android APK's push is unaffected).
# Browsers only allow notifications on https:// pages (or http://localhost).
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact for the push services if this server misbehaves (mailto: or https:).
WEB_PUSH_SUBJECT=mailto:moganrajg@tii.murugappa.com

# OTP behaviour. Defaults shown.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5

# Per-IP limits on the public OTP endpoints (send / verify+complete).
RATE_LIMIT_OTP_SEND_WINDOW_MS=900000
RATE_LIMIT_OTP_SEND_MAX=10
RATE_LIMIT_OTP_VERIFY_WINDOW_MS=900000
RATE_LIMIT_OTP_VERIFY_MAX=30

# Initial superadmin created by `npm run seed:admin`. Leave the password
# empty to have a strong random one generated and printed once.
ADMIN_SEED_EMAIL=moganrajg@tii.murugappa.com
ADMIN_SEED_NAME=Moganraj G
ADMIN_SEED_EMPLOYEE_ID=ADMIN001
ADMIN_SEED_PASSWORD=
