PORT=5000
# development here is a local-dev default only. Production deployments MUST
# set this to `production` explicitly — it's what makes CORS fail closed
# (config/cors.js) and stops 500 errors from leaking raw driver/Prisma
# messages to clients (middleware/errorHandler.js). Forgetting to change it
# doesn't stop the app from running, so it's easy to miss unless checked.
NODE_ENV=development

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=365d

POLL_OPEN_AFTER_SHIFT_MINUTES=30
POLL_CLOSE_BEFORE_NEXT_SHIFT_HOURS=2
POLL_AUTOMATION_INTERVAL_MS=60000
REMINDER_CHECK_INTERVAL_MS=300000

# Postgres via Prisma. If pooling through PgBouncer/Supabase's transaction
# pooler (pgbouncer=true), keep connection_limit modest — PgBouncer already
# multiplexes many app-level connections onto a small number of real ones;
# 300-400 workers making short, bursty requests around shift changes are
# comfortably served by connection_limit=10-20 here, not one-per-worker.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=15"
# Session-mode/direct connection, used for migrations (`prisma migrate`).
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Security hardening ---

# Comma-separated list of browser origins allowed to call this API (the
# webfrontend / hrfrontend URLs). No Origin header at all (mobile app,
# curl, server-to-server) is never subject to this — CORS only gates
# browser fetch()/XHR calls. Leaving this unset in production means no
# browser origin is allowed (fail closed); in development it defaults to
# http://localhost:5173 and http://localhost:5174.
# Example: CORS_ALLOWED_ORIGINS=https://hr.flexitrack.example.com
CORS_ALLOWED_ORIGINS=

# Set to the number of reverse-proxy hops in front of this process (usually
# 1) ONLY when actually deployed behind one (nginx, a load balancer, a PaaS
# router). Leave unset/0 for direct LAN access — trusting X-Forwarded-For
# without an actual proxy in front lets a client spoof its IP and dodge
# per-IP rate limiting.
TRUST_PROXY=0

# Max JSON request body size accepted by express.json().
BODY_LIMIT=100kb

# Rate limits. *_WINDOW_MS is the rolling window, *_MAX is the request cap
# per source IP within that window.
#   LOGIN      -> POST /api/auth/login, POST /api/hr/login
#   SENSITIVE  -> account/credential writes (team & HR-admin CRUD, password
#                 change, plant CRUD) — low-volume, HR/incharge-only actions
#   API        -> blanket backstop across all of /api/*, sized for the full
#                 300-400 worker load polling around shift changes
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_SENSITIVE_WINDOW_MS=900000
RATE_LIMIT_SENSITIVE_MAX=60
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=600
